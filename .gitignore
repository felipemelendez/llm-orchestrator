.DS_Store
node_modules/
*.log
.orch-cache/
.orch-worktree
.worktrees/
.claude/scheduled_tasks.lock
docs/llm-orchestrator/scratch/
# Internal build artifacts (specs/plans/research/handoffs we generate to build the
# system) — never committed.
docs/llm-orchestrator/specs/
docs/llm-orchestrator/plans/
docs/llm-orchestrator/handoffs/
docs/llm-orchestrator/research/

# claude plugin eval results (one directory per run) and review-compare runs.
# results/benchmark.json, raw.jsonl and archive/ are the committed history.
tests/evals/results/20*/
tests/evals/review-compare/work/

# Agent worktrees created by the Agent tool. Real git worktrees, never content.
.claude/worktrees/

# Python verification and provider helpers
__pycache__/
*.py[cod]
.claude/settings.json.bak
.claude/settings.json.bak.*
AGENTS.md.bak*
CLAUDE.md.bak*
