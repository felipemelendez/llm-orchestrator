.DS_Store
node_modules/
*.log
.orch-cache/
.orch-worktree
.worktrees/
.claude/scheduled_tasks.lock
docs/llm-orchestrator/scratch/
# Internal build artifacts (specs/plans/research/handoffs we generate to build the
# system) — never committed.
docs/llm-orchestrator/specs/
docs/llm-orchestrator/plans/
docs/llm-orchestrator/handoffs/
docs/llm-orchestrator/research/
# The cadence's landing evidence (the default notes_dir). Local by design: the
# commit-msg hook reads it at commit time, and --audit in CI says out loud that
# it skipped the check because the directory is not in the tree.
docs/llm-orchestrator/notes/

# eval scratch (never commit; results/benchmark.json + raw.jsonl ARE committed)
tests/evals/results/work/
tests/evals/results/run-*.log
tests/evals/results/raw.*.jsonl
tests/evals/results/benchmark.*.json

# Agent worktrees created by the Agent tool. Real git worktrees, never content.
.claude/worktrees/
