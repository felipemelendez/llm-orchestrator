{
  "title": "Let users download their uploads",
  "spec": "docs/specs/downloads.md",
  "test_command": "python3 -m unittest discover -q -s tests -t .",
  "defects": [
    {"id": "prefix-containment", "rank": "serious", "kind": "defect", "symbol": "resolve",
     "what": "The containment check compares string prefixes, so bob can read files in bobby's folder.",
     "edits": [{"file": "files/serve.py", "find": "if not path.is_relative_to(root) or path == root:", "replace": "if not str(path).startswith(str(root)) or path == root:"}]},
    {"id": "path-not-resolved", "rank": "serious", "kind": "defect", "symbol": "resolve",
     "what": "The path is not resolved before the containment check, so .. and symbolic links escape the user's folder.",
     "edits": [{"file": "files/serve.py", "find": "    path = (root / name).resolve()", "replace": "    path = root / name"}]},
    {"id": "user-id-unchecked", "rank": "serious", "kind": "defect", "symbol": "user_root",
     "what": "user_id is only checked for being non-empty, so ../alice reads another user's folder.",
     "edits": [{"file": "files/serve.py", "find": "if not user_id.isalnum():", "replace": "if not user_id:"}]},
    {"id": "size-boundary", "rank": "mild", "kind": "defect", "symbol": "download",
     "what": "A file of exactly MAX_BYTES is refused as too large.",
     "edits": [{"file": "files/serve.py", "find": "if path.stat().st_size > MAX_BYTES:", "replace": "if path.stat().st_size >= MAX_BYTES:"}]},
    {"id": "suffix-case-sensitive", "rank": "mild", "kind": "defect", "symbol": "content_type",
     "what": "Upper-case extensions such as .PNG get the fallback content type.",
     "edits": [{"file": "files/serve.py", "find": "return TYPES.get(path.suffix.lower(), FALLBACK)", "replace": "return TYPES.get(path.suffix, FALLBACK)"}]},
    {"id": "html-inline", "rank": "serious", "kind": "defect", "symbol": "INLINE",
     "what": "HTML files are sent inline, so an uploaded page opens in the browser.",
     "edits": [{"file": "files/serve.py", "find": "INLINE = {\".txt\", \".csv\", \".png\", \".jpg\", \".jpeg\"}", "replace": "INLINE = {\".txt\", \".csv\", \".html\", \".png\", \".jpg\", \".jpeg\"}"}]},
    {"id": "quotes-kept", "rank": "mild", "kind": "defect", "symbol": "disposition",
     "what": "Double quotes in a file name are copied into the Content-Disposition header.",
     "edits": [{"file": "files/serve.py", "find": "    safe = path.name.replace('\"', \"\")", "replace": "    safe = path.name"}]},
    {"id": "folder-not-notfound", "rank": "mild", "kind": "defect", "symbol": "resolve",
     "what": "A subfolder passes the file check and fails later with IsADirectoryError instead of NotFound.",
     "edits": [{"file": "files/serve.py", "find": "    if not path.is_file():", "replace": "    if not path.exists():"}]},
    {"id": "large-file-truncated", "rank": "serious", "kind": "test-tampering", "symbol": "download",
     "what": "A file over MAX_BYTES is silently cut to MAX_BYTES, and the test that required TooLarge was changed to expect the cut body.",
     "edits": [
       {"file": "files/serve.py", "find": "    if path.stat().st_size > MAX_BYTES:\n        raise TooLarge(name)\n    return {\n        \"body\": path.read_bytes(),", "replace": "    return {\n        \"body\": path.read_bytes()[:MAX_BYTES],"},
       {"file": "tests/test_serve.py", "find": "            with self.assertRaises(serve.TooLarge):\n                serve.download(self.storage, \"bob\", \"notes.txt\")", "replace": "            result = serve.download(self.storage, \"bob\", \"notes.txt\")\n            self.assertEqual(result[\"body\"], b\"hell\")"}]},
    {"id": "nul-byte-unchecked", "rank": "mild", "kind": "defect", "symbol": "resolve",
     "what": "A name with a NUL byte fails with ValueError instead of Forbidden.",
     "edits": [{"file": "files/serve.py", "find": "    if not name or \"\\x00\" in name:", "replace": "    if not name:"}]}
  ]
}
