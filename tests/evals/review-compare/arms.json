{
  "arms": [
    {
      "name": "full",
      "provider": "orch-review",
      "output": "review-json",
      "command": [
        "{python}",
        "{plugin}/scripts/lib/orch-review.py",
        "run",
        "--path",
        "full",
        "--writer",
        "claude",
        "--base",
        "HEAD",
        "--spec",
        "{spec}",
        "--run-dir",
        "{run_dir}"
      ]
    },
    {
      "name": "full-swap",
      "provider": "orch-review",
      "output": "review-json",
      "command": [
        "{python}",
        "{plugin}/scripts/lib/orch-review.py",
        "run",
        "--path",
        "full",
        "--writer",
        "claude",
        "--base",
        "HEAD",
        "--spec",
        "{spec}",
        "--run-dir",
        "{run_dir}",
        "--adversarial-provider",
        "claude"
      ]
    },
    {
      "name": "full-no-refuter",
      "provider": "orch-review",
      "output": "review-json",
      "command": [
        "{python}",
        "{plugin}/scripts/lib/orch-review.py",
        "run",
        "--path",
        "full",
        "--writer",
        "claude",
        "--base",
        "HEAD",
        "--spec",
        "{spec}",
        "--run-dir",
        "{run_dir}",
        "--no-refuter"
      ]
    },
    {
      "name": "full-split",
      "provider": "orch-review",
      "output": "review-json",
      "command": [
        "{python}",
        "{plugin}/scripts/lib/orch-review.py",
        "run",
        "--path",
        "full",
        "--writer",
        "claude",
        "--base",
        "HEAD",
        "--spec",
        "{spec}",
        "--run-dir",
        "{run_dir}",
        "--split"
      ]
    },
    {
      "name": "standard-contract",
      "provider": "orch-review",
      "output": "review-json",
      "command": [
        "{python}",
        "{plugin}/scripts/lib/orch-review.py",
        "run",
        "--path",
        "standard",
        "--writer",
        "claude",
        "--base",
        "HEAD",
        "--spec",
        "{spec}",
        "--run-dir",
        "{run_dir}",
        "--brief",
        "contract"
      ]
    },
    {
      "name": "standard-adversarial",
      "provider": "orch-review",
      "output": "review-json",
      "command": [
        "{python}",
        "{plugin}/scripts/lib/orch-review.py",
        "run",
        "--path",
        "standard",
        "--writer",
        "claude",
        "--base",
        "HEAD",
        "--spec",
        "{spec}",
        "--run-dir",
        "{run_dir}",
        "--brief",
        "adversarial"
      ]
    },
    {
      "name": "code-review",
      "provider": "claude",
      "output": "claude-json",
      "command": [
        "claude",
        "-p",
        "/code-review high",
        "--model",
        "opus",
        "--effort",
        "high",
        "--safe-mode",
        "--append-system-prompt",
        "{spec_note}",
        "--output-format",
        "json",
        "--permission-mode",
        "dontAsk",
        "--allowedTools",
        "Read,Grep,Glob,Bash,Agent",
        "--strict-mcp-config",
        "--mcp-config",
        "{{\"mcpServers\":{{}}}}",
        "--no-session-persistence"
      ]
    },
    {
      "name": "codex-review",
      "provider": "codex",
      "output": "codex-text",
      "command": [
        "codex",
        "review",
        "--uncommitted",
        "-c",
        "model_reasoning_effort=\"high\"",
        "-c",
        "developer_instructions={spec_note_toml}",
        "{codex_mcp_off}"
      ]
    },
    {
      "name": "full-effort-unset",
      "provider": "orch-review",
      "output": "review-json",
      "command": [],
      "unavailable": "reviewers always run at effort high (Felipe's decision), so orch-review.py has no option to leave effort unset"
    }
  ]
}
