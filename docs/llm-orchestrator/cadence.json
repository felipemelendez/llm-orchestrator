{
  "schema": 1,
  "enabled": true,
  "workflow": "proportional",
  "notes_dir": "docs/llm-orchestrator/notes",
  "ticket_re": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)+:",
  "runner": {
    "profile": "shell-suites",
    "test_cmd": "",
    "summary_re": "^(PASS|FAIL)|[0-9]+ (passed|failed)|^FAILED",
    "fail_count_re": "([0-9]+) failed",
    "suites_re": ""
  },
  "typecheck_cmd": "",
  "unused_cmd": "",
  "src_roots": [
    "scripts",
    "tests",
    "hooks",
    "skills",
    "commands",
    "agents",
    "workflows",
    "templates",
    "output-styles"
  ],
  "prod_globs": [
    "scripts/**",
    "skills/**",
    "hooks/**",
    "agents/**",
    "commands/**",
    "templates/**",
    "workflows/**",
    "output-styles/**"
  ],
  "test_globs": [
    "tests/**"
  ],
  "lang_globs": [
    "*.sh"
  ],
  "suite_globs": [
    "tests/**/test-*.sh",
    "tests/validate-*.sh"
  ],
  "import_patterns": [
    "{base}\\.sh"
  ],
  "export_pattern": "^[A-Za-z_][A-Za-z0-9_]*\\(\\)",
  "comment_prefixes": [
    "#"
  ],
  "positive_control": {
    "file_ext": ".sh",
    "snippet": "if then; fi",
    "expect_marker": "syntax error"
  },
  "wait_patterns": [],
  "wait_timeout_s": 1800,
  "scratch_dir": "",
  "refuse_paths": [],
  "lock_extra": [],
  "install_cmd": "",
  "verification_config_globs": [
    ".claude-plugin/**",
    ".github/**",
    "AGENTS.md",
    "CLAUDE.md",
    ".claude/settings*.json",
    ".codex/config.toml",
    ".gitignore",
    ".gitattributes",
    ".mcp.json",
    ".mcp.json.example",
    "docs/llm-orchestrator/LAWS.md",
    "docs/llm-orchestrator/CODEX.md",
    "docs/llm-orchestrator/LOCK.sha256"
  ]
}
